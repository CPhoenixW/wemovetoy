# PostgreSQL Docker Compose configuration
POSTGRES_DB=wemove
POSTGRES_USER=wemove
POSTGRES_PASSWORD=wemove_dev_password
POSTGRES_PORT=5432

# Application database connection. Keep this aligned with the values above.
DATABASE_URL="postgresql://wemove:wemove_dev_password@localhost:5432/wemove?schema=public"

# Backend application configuration
PORT=3000
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_EXPIRES_IN=1d
